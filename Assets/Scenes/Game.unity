--- !u!114 &2141395209
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2141395207}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 55ec624d96641ec4997531c7eee1509e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LineObj
  lines:
  - type: 0
    text: ..is this..
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: My GAME??!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: Oh no..
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: There's no way I'm inside my own game
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: I must have fallen asleep or something!!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: I wanna wake up!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: NOW!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: ...
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: I ain't waking up, am I?
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: That's..
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: Horrible
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: How am I gonna even get out??
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: ...
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: this is some real pickle I've gotten myself into again...
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: What if...
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: I caused an error?
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: That could do!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: And then the game should revert to default!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: And I'll be out of here!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: Let's see...
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: if I recall correctly the TV was quite buggy if I held something blue..
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
  - type: 0
    text: Lemme try that real quick!
    activeSpeaker: {fileID: 0}
    textSpeed: 0
    choices: []
